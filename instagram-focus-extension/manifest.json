{
  "manifest_version": 3,
  "name": "Instagram Focus – Home Feed Only",
  "version": "1.0.0",
  "description": "Blocks Instagram's Search/Explore and Reels pages so only your home feed is left.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://*.instagram.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "block_search", "enabled": true, "path": "rules/block_search.json" },
      { "id": "block_reels", "enabled": true, "path": "rules/block_reels.json" },
      { "id": "block_single_reels", "enabled": false, "path": "rules/block_single_reels.json" }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Instagram Focus",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "instagram-focus@example.local",
      "strict_min_version": "128.0"
    }
  }
}
